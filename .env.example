NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile site key. When set, login and register show the captcha widget.
# Also enable "Enable Captcha protection" (Turnstile + secret) in Supabase → Authentication → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Email notifications (Resend). Without RESEND_API_KEY nothing is sent and the queue just waits.
RESEND_API_KEY=
EMAIL_FROM=Sigap <notifikasi@domainmu.id>
# For the scheduled sender at GET /api/cron/email (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
